# Copy this file to .env and fill in your own values:
#   cp .env.example .env && chmod 600 .env
#
# .env is listed in .gitignore and must never be committed.
# Only the AI steps need this; the core pipeline runs without it.

# API key for FreeLLMAPI (the LLM gateway used by the optional AI steps)
FREELLMAPI_API_KEY=
