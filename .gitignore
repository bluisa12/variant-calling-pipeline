# Secrets: API keys live in .env, which must never be committed.
# .env.example (no real values) is committed so others know what to set.
.env
.env.*
!.env.example

# Large genomic data: download with scripts/download_data.sh instead of committing
data/
results/
*.bam
*.bai
*.cram
*.fastq.gz
*.fq.gz
*.vcf.gz
*.tbi

# Snakemake
.snakemake/

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/

# macOS
.DS_Store
